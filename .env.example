# Neon
DATABASE_URL=""

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Secreto de firma del endpoint /api/webhooks/clerk (Clerk Dashboard → Webhooks).
# Sin él, el webhook rechaza todo evento: nadie tendría fila en `users`.
CLERK_WEBHOOK_SIGNING_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
# Secreto de firma del endpoint /api/webhooks/stripe (Stripe Dashboard o
# `stripe listen --print-secret` en desarrollo). Ver docs/stripe/checkout-integration.md.
STRIPE_WEBHOOK_SIGNING_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed (opcional) — email de un usuario ya existente en `users` al que
# `npm run db:seed` le asigna el rol super_admin. Solo lo lee el seed.
BOOTSTRAP_SUPER_ADMIN_EMAIL=""
